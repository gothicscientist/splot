: "b14", "text": "Lustig", "start": 56.6417, "end": 56.9437, "s": 1699, "e": 1708, "emph": false}, {"i": 176, "beat": "b14", "text": "escapes", "start": 56.9837, "end": 57.3057, "s": 1710, "e": 1719, "emph": false}, {"i": 177, "beat": "b14", "text": "to", "start": 57.3457, "end": 57.4457, "s": 1720, "e": 1723, "emph": false}, {"i": 178, "beat": "b14", "text": "America.", "start": 57.4657, "end": 57.8077, "s": 1724, "e": 1734, "emph": true}, {"i": 179, "beat": "b15", "text": "But", "start": 58.1483, "end": 58.2483, "s": 1744, "e": 1747, "emph": false}, {"i": 180, "beat": "b15", "text": "historians", "start": 58.2883, "end": 58.8093, "s": 1749, "e": 1764, "emph": false}, {"i": 181, "beat": "b15", "text": "have", "start": 58.8493, "end": 58.9693, "s": 1765, "e": 1769, "emph": false}, {"i": 182, "beat": "b15", "text": "never", "start": 59.1893, "end": 59.4103, "s": 1776, "e": 1782, "emph": false}, {"i": 183, "beat": "b15", "text": "found", "start": 59.4703, "end": 59.7303, "s": 1784, "e": 1792, "emph": false}, {"i": 184, "beat": "b15", "text": "a", "start": 59.7903, "end": 59.8503, "s": 1794, "e": 1796, "emph": false}, {"i": 185, "beat": "b15", "text": "single", "start": 59.9103, "end": 60.1713, "s": 1797, "e": 1805, "emph": false}, {"i": 186, "beat": "b15", "text": "police", "start": 60.2113, "end": 60.5313, "s": 1806, "e": 1816, "emph": false}, {"i": 187, "beat": "b15", "text": "report.", "start": 60.5713, "end": 60.9113, "s": 1817, "e": 1827, "emph": false}, {"i": 188, "beat": "b15", "text": "The", "start": 61.0523, "end": 61.1523, "s": 1832, "e": 1835, "emph": false}, {"i": 189, "beat": "b15", "text": "only", "start": 61.2123, "end": 61.3723, "s": 1836, "e": 1841, "emph": false}, {"i": 190, "beat": "b15", "text": "proof", "start": 61.4523, "end": 61.7523, "s": 1844, "e": 1853, "emph": false}, {"i": 191, "beat": "b15", "text": "might", "start": 61.8333, "end": 61.9733, "s": 1855, "e": 1859, "emph": false}, {"i": 192, "beat": "b15", "text": "be", "start": 61.9933, "end": 62.0933, "s": 1860, "e": 1863, "emph": false}, {"i": 193, "beat": "b15", "text": "a", "start": 62.1133, "end": 62.1733, "s": 1863, "e": 1865, "emph": false}, {"i": 194, "beat": "b15", "text": "con", "start": 62.1733, "end": 62.3733, "s": 1865, "e": 1871, "emph": false}, {"i": 195, "beat": "b15", "text": "man's", "start": 62.3933, "end": 62.6343, "s": 1872, "e": 1879, "emph": false}, {"i": 196, "beat": "b15", "text": "word.", "start": 62.6743, "end": 62.8543, "s": 1880, "e": 1886, "emph": true}], "beats": [{"id": "b01", "shot": "s01", "role": "hook", "text": "This man sold the Eiffel Tower... for scrap metal.", "s": 2, "speechEnd": 80, "e": 87, "words": [0, 8], "transition": null}, {"id": "b02", "shot": "s02", "role": null, "text": "Paris, 1925. Victor Lustig is reading the paper when he spots a tiny story.", "s": 87, "speechEnd": 254, "e": 258, "words": [9, 22], "transition": null}, {"id": "b03", "shot": "s02", "role": null, "text": "The tower is rusting, and repainting it costs a fortune.", "s": 258, "speechEnd": 347, "e": 352, "words": [23, 32], "transition": null}, {"id": "b04", "shot": "s03", "role": null, "text": "So he forges government letterhead and becomes a deputy director at the Ministry of Posts.", "s": 352, "speechEnd": 491, "e": 496, "words": [33, 47], "transition": "dissolve"}, {"id": "b05", "shot": "s04", "role": null, "text": "He books a suite at the H\u00f4tel de Crillon and invites five scrap dealers.", "s": 496, "speechEnd": 614, "e": 618, "words": [48, 61], "transition": "push"}, {"id": "b06", "shot": "s04", "role": null, "text": "His pitch: the city is secretly tearing the tower down. Seven thousand tons of iron.", "s": 618, "speechEnd": 756, "e": 761, "words": [62, 76], "transition": null}, {"id": "b07", "shot": "s05", "role": null, "text": "One dealer, Andr\u00e9 Poisson, wants it badly. But something feels off.", "s": 761, "speechEnd": 869, "e": 873, "words": [77, 87], "transition": "whip-right"}, {"id": "b08", "shot": "s05", "role": null, "text": "So Lustig makes a confession. He's a corrupt official, and he needs a bribe.", "s": 873, "speechEnd": 982, "e": 987, "words": [88, 101], "transition": null}, {"id": "b09", "shot": "s06", "role": "pivot", "text": "You see, to Poisson, the bribe was the proof. Only a real official would ask for one.", "s": 987, "speechEnd": 1129, "e": 1132, "words": [102, 118], "transition": "push"}, {"id": "b10", "shot": "s06", "role": null, "text": "So Poisson pays $20,000, plus $50,000 more to win.", "s": 1132, "speechEnd": 1289, "e": 1293, "words": [119, 127], "transition": null}, {"id": "b11", "shot": "s07", "role": null, "text": "Within the hour, Lustig is on a train to Vienna with the cash.", "s": 1293, "speechEnd": 1380, "e": 1385, "words": [128, 140], "transition": "whip-left"}, {"id": "b12", "shot": "s08", "role": null, "text": "He waits for the headlines. Nothing. Poisson is too embarrassed to report it.", "s": 1385, "speechEnd": 1520, "e": 1525, "words": [141, 153], "transition": "dip"}, {"id": "b13", "shot": "s09", "role": null, "text": "So Lustig comes back to Paris and tries to sell the tower again.", "s": 1525, "speechEnd": 1623, "e": 1625, "words": [154, 166], "transition": "flash"}, {"id": "b14", "shot": "s09", "role": null, "text": "This time, the buyer calls the police, and Lustig escapes to America.", "s": 1625, "speechEnd": 1739, "e": 1744, "words": [167, 178], "transition": null}, {"id": "b15", "shot": "s10", "role": "payoff", "text": "But historians have never found a single police report. The only proof might be a con man's word.", "s": 1744, "speechEnd": 1890, "e": 1890, "words": [179, 196], "transition": "dissolve"}], "shots": [{"id": "s01", "beats": ["b01"], "s": 0, "e": 84, "transitionIn": null}, {"id": "s02", "beats": ["b02", "b03"], "s": 84, "e": 349, "transitionIn": "whip-left"}, {"id": "s03", "beats": ["b04"], "s": 349, "e": 493, "transitionIn": "dissolve"}, {"id": "s04", "beats": ["b05", "b06"], "s": 493, "e": 758, "transitionIn": "push"},
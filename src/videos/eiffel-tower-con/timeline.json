175, "beat": "b14", "text": "Lustig", "start": 57.553, "end": 57.935, "s": 1727, "e": 1738, "emph": false}, {"i": 176, "beat": "b14", "text": "escapes", "start": 57.976, "end": 58.298, "s": 1739, "e": 1749, "emph": false}, {"i": 177, "beat": "b14", "text": "to", "start": 58.338, "end": 58.459, "s": 1750, "e": 1754, "emph": false}, {"i": 178, "beat": "b14", "text": "America.", "start": 58.499, "end": 58.861, "s": 1755, "e": 1766, "emph": true}, {"i": 179, "beat": "b15", "text": "But", "start": 59.1821, "end": 59.3221, "s": 1775, "e": 1780, "emph": false}, {"i": 180, "beat": "b15", "text": "historians", "start": 59.4431, "end": 59.9441, "s": 1783, "e": 1798, "emph": false}, {"i": 181, "beat": "b15", "text": "have", "start": 59.9841, "end": 60.1041, "s": 1800, "e": 1803, "emph": false}, {"i": 182, "beat": "b15", "text": "never", "start": 60.2051, "end": 60.4051, "s": 1806, "e": 1812, "emph": false}, {"i": 183, "beat": "b15", "text": "found", "start": 60.4851, "end": 60.7261, "s": 1815, "e": 1822, "emph": false}, {"i": 184, "beat": "b15", "text": "a", "start": 60.7661, "end": 60.8261, "s": 1823, "e": 1825, "emph": false}, {"i": 185, "beat": "b15", "text": "single", "start": 60.9061, "end": 61.2071, "s": 1827, "e": 1836, "emph": false}, {"i": 186, "beat": "b15", "text": "police", "start": 61.2471, "end": 61.5281, "s": 1837, "e": 1846, "emph": false}, {"i": 187, "beat": "b15", "text": "report.", "start": 61.5681, "end": 61.8891, "s": 1847, "e": 1857, "emph": false}, {"i": 188, "beat": "b15", "text": "The", "start": 62.0291, "end": 62.1291, "s": 1861, "e": 1864, "emph": false}, {"i": 189, "beat": "b15", "text": "only", "start": 62.2501, "end": 62.4301, "s": 1868, "e": 1873, "emph": false}, {"i": 190, "beat": "b15", "text": "proof", "start": 62.5101, "end": 62.8111, "s": 1875, "e": 1884, "emph": false}, {"i": 191, "beat": "b15", "text": "might", "start": 63.0321, "end": 63.2121, "s": 1891, "e": 1896, "emph": false}, {"i": 192, "beat": "b15", "text": "be", "start": 63.2521, "end": 63.3521, "s": 1898, "e": 1901, "emph": false}, {"i": 193, "beat": "b15", "text": "a", "start": 63.4121, "end": 63.4721, "s": 1902, "e": 1904, "emph": false}, {"i": 194, "beat": "b15", "text": "con", "start": 63.4931, "end": 63.7331, "s": 1905, "e": 1912, "emph": false}, {"i": 195, "beat": "b15", "text": "man's", "start": 63.7531, "end": 63.9941, "s": 1913, "e": 1920, "emph": false}, {"i": 196, "beat": "b15", "text": "word.", "start": 64.0341, "end": 64.2341, "s": 1921, "e": 1927, "emph": true}], "beats": [{"id": "b01", "shot": "s01", "role": "hook", "text": "This man sold the Eiffel Tower... for scrap metal.", "s": 2, "speechEnd": 109, "e": 116, "words": [0, 8], "transition": null}, {"id": "b02", "shot": "s02", "role": null, "text": "Paris, 1925. Victor Lustig is reading the paper when he spots a tiny story.", "s": 116, "speechEnd": 276, "e": 279, "words": [9, 22], "transition": null}, {"id": "b03", "shot": "s02", "role": null, "text": "The tower is rusting, and repainting it costs a fortune.", "s": 279, "speechEnd": 370, "e": 375, "words": [23, 32], "transition": null}, {"id": "b04", "shot": "s03", "role": null, "text": "So he forges government letterhead and becomes a deputy director at the Ministry of Posts.", "s": 375, "speechEnd": 514, "e": 519, "words": [33, 47], "transition": "dissolve"}, {"id": "b05", "shot": "s04", "role": null, "text": "He books a suite at the H\u00f4tel de Crillon and invites five scrap dealers.", "s": 519, "speechEnd": 631, "e": 635, "words": [48, 61], "transition": "push"}, {"id": "b06", "shot": "s04", "role": null, "text": "His pitch: the city is secretly tearing the tower down. Seven thousand tons of iron.", "s": 635, "speechEnd": 784, "e": 789, "words": [62, 76], "transition": null}, {"id": "b07", "shot": "s05", "role": null, "text": "One dealer, Andr\u00e9 Poisson, wants it badly. But something feels off.", "s": 789, "speechEnd": 914, "e": 917, "words": [77, 87], "transition": "whip-right"}, {"id": "b08", "shot": "s05", "role": null, "text": "So Lustig makes a confession. He's a corrupt official, and he needs a bribe.", "s": 917, "speechEnd": 1046, "e": 1051, "words": [88, 101], "transition": null}, {"id": "b09", "shot": "s06", "role": "pivot", "text": "You see, to Poisson, the bribe was the proof. Only a real official would ask for one.", "s": 1051, "speechEnd": 1187, "e": 1190, "words": [102, 118], "transition": "push"}, {"id": "b10", "shot": "s06", "role": null, "text": "So Poisson pays $20,000, plus $50,000 more to win.", "s": 1190, "speechEnd": 1330, "e": 1335, "words": [119, 127], "transition": null}, {"id": "b11", "shot": "s07", "role": null, "text": "Within the hour, Lustig is on a train to Vienna with the cash.", "s": 1335, "speechEnd": 1430, "e": 1435, "words": [128, 140], "transition": "whip-left"}, {"id": "b12", "shot": "s08", "role": null, "text": "He waits for the headlines. Nothing. Poisson is too embarrassed to report it.", "s": 1435, "speechEnd": 1550, "e": 1555, "words": [141, 153], "transition": "dip"}, {"id": "b13", "shot": "s09", "role": null, "text": "So Lustig comes back to Paris and tries to sell the tower again.", "s": 1555, "speechEnd": 1660, "e": 1661, "words": [154, 166], "transition": "flash"}, {"id": "b14", "shot": "s09", "role": null, "text": "This time, the buyer calls the police, and Lustig escapes to America.", "s": 1661, "speechEnd": 1770, "e": 1775, "words": [167, 178], "transition": null}, {"id": "b15", "shot": "s10", "role": "payoff", "text": "But historians have never found a single police report. The only proof might be a con man's word.", "s": 1775, "speechEnd": 1932, "e": 1932, "words": [179, 196], "transition": "dissolve"}], "shots": [{"id": "s01", "beats": ["b01"], "s": 0, "e": 113, "transitionIn": null}, {"id": "s02", "beats": ["b02", "b03"], "s": 113, "e": 372, "transitionIn": "whip-left"}, {"id": "s03", "beats": ["b04"], "s": 372, "e": 516, "transitionIn": "dissolve"}, {"id": "s04", "beats": ["b05", "b06"], "s": 516, "e": 786, "transitionIn": "push"}, {"id": "s05", "beats": ["b07", "b08"], "s": 786, "e": 1048, "transitionIn": "whip-right"}, {"id": "s06", "beats": ["b09", "b10"], "s": 1048, "e": 1332, "transitionIn": "push"}, {"id": "s07", "beats": ["b11"], "s": 1332, "e": 1432, "transitionIn": "whip-left"}, {"id": "s08", "beats": ["b12"], "s": 1432, "e": 1552, "transitionIn": "dip"}, {"id": "s09", "beats": ["b13", "b14"], "s": 1552, "e": 1772, "transitionIn": "flash"}, {"id": "s10", "beats": ["b15"], "s": 1772, "e": 1954, "transitionIn": "dissolve"}], "captions": [{"text": "This man", "words": [0, 1], "s": 7, "e": 25, "emph": false, "beat": "b01"}, {"text": "sold", "words": [2], "s": 25, "e": 34, "emph": false, "beat": "b01"}, {"text": "the Eiffel Tower...", "words": [3, 4, 5], "s": 34, "e": 76, "emph": true, "beat": "b01"}, {"text": "for scrap", "words": [6, 7], "s": 76, "e": 97, "emph": false, "beat": "b01"}, {"text": "metal.", "words": [8], "s": 97, "e": 117, "emph": false, "beat": "b01"}, {"text": "Paris,", "words": [9], "s": 117, "e": 138, "emph": false, "beat": "b02"}, {"text": "1925.", "words": [10], "s": 138, "e": 176, "emph": false, "beat": "b02"}, {"text": "Victor", "words": [11], "s": 176, "e": 185, "emph": false, "beat": "b02"}, {"text": "Lustig", "words": [12], "s": 185, "e": 200, "emph": false, "beat": "b02"}, {"text": "is reading", "words": [13, 14], "s": 200, "e": 213, "emph": false, "beat": "b02"}, {"text": "the paper", "words": [15, 16], "s": 213, "e": 229, "emph": false, "beat": "b02"}, {"text": "when", "words": [17], "s": 229, "e": 233, "emph": false, "beat": "b02"}, {"text": "he spots", "words": [18, 19], "s": 233, "e": 248, "emph": false, "beat": "b02"}, {"text": "a tiny", "words": [20, 21], "s": 248, "e": 263, "emph": false, "beat": "b02"}, {"text": "story.", "words": [22], "s": 263, "e": 280, "emph": false, "beat": "b02"}, {"text": "The tower", "words": [23, 24], "s": 280, "e": 294, "emph": false, "beat": "b03"}, {"text": "is rusting,", "words": [25, 26], "s": 294, "e": 316, "e
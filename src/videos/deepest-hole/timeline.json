4, "emph": false}], "beats": [{"id": "b01", "shot": "s01", "role": "hook", "text": "What if you dug straight down and never stopped?", "s": 2, "speechEnd": 79, "e": 86, "words": [0, 8], "transition": null}, {"id": "b02", "shot": "s02", "role": null, "text": "In 1970, Soviet scientists tried it for real.", "s": 86, "speechEnd": 170, "e": 171, "words": [9, 16], "transition": "whip-down"}, {"id": "b03", "shot": "s02", "role": null, "text": "Their hole was just 23 centimeters wide, about the size of a dinner plate.", "s": 171, "speechEnd": 286, "e": 291, "words": [17, 30], "transition": null}, {"id": "b04", "shot": "s03", "role": null, "text": "For nineteen years, the drill went down. One kilometer. Five. Ten.", "s": 291, "speechEnd": 421, "e": 425, "words": [31, 41], "transition": "whip-down"}, {"id": "b05", "shot": "s03", "role": null, "text": "At 12,262 meters, it became the deepest hole humans have ever made.", "s": 425, "speechEnd": 580, "e": 585, "words": [42, 53], "transition": null}, {"id": "b06", "shot": "s04", "role": null, "text": "But down there, something was wrong.", "s": 585, "speechEnd": 642, "e": 644, "words": [54, 59], "transition": "dip"}, {"id": "b07", "shot": "s04", "role": null, "text": "The rock was 180 degrees Celsius, far hotter than anyone expected.", "s": 644, "speechEnd": 767, "e": 772, "words": [60, 70], "transition": null}, {"id": "b08", "shot": "s05", "role": "pivot", "text": "You see, at that heat, rock stops acting like rock. It starts to behave like plastic.", "s": 772, "speechEnd": 909, "e": 911, "words": [71, 86], "transition": "push"}, {"id": "b09", "shot": "s05", "role": null, "text": "The drill simply could not go any deeper.", "s": 911, "speechEnd": 980, "e": 984, "words": [87, 94], "transition": null}, {"id": "b10", "shot": "s06", "role": null, "text": "So how far did they get? The center of the Earth is 6,371 kilometers down.", "s": 984, "speechEnd": 1124, "e": 1126, "words": [95, 109], "transition": "zoom-out"}, {"id": "b11", "
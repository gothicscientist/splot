 "flash"}, {"id": "b10", "shot": "s06", "role": null, "text": "The line would follow the highest peaks of the Andes.", "s": 962, "speechEnd": 1043, "e": 1047, "words": [93, 102], "transition": null}, {"id": "b11", "shot": "s07", "role": null, "text": "So Chile kept the narrow strip between the mountains and the sea.", "s": 1047, "speechEnd": 1147, "e": 1148, "words": [103, 114], "transition": "zoom-out"}, {"id": "b12", "shot": "s07", "role": "payoff", "text": "It's not a strange shape. It's the edge of a continent.", "s": 1148, "speechEnd": 1236, "e": 1236, "words": [115, 125], "transition": null}], "shots": [{"id": "s01", "beats": ["b01"], "s": 0, "e": 106, "transitionIn": null}, {"id": "s02", "beats": ["b02", "b03"], "s": 106, "e": 355, "transitionIn": "push"}, {"id": "s03", "beats": ["b04"], "s": 355, "e": 487, "transitionIn": "whip-right"}, {"id": "s04", "beats": ["b05", "b06"], "s": 487, "e": 661, "transitionIn": "whip-left"}, {"id": "s05", "beats": ["b07", "b08"], "s": 661, "e": 844, "transitionIn": "dissolve"}, {"id": "s06", "beats": ["b09", "b10"], "s": 844, "e": 1044, "transitionIn": "flash"}, {"id": "s07", "beats": ["b11", "b12"], "s": 1044, "e": 1258, "transitionIn": "zoom-out"}], "captions": [{"text": "This country", "words": [0, 1], "s": 4, "e": 24, "emph": false, "beat": "b01"}, {"text": "is 24 times", "words": [2, 3, 4], "s": 24, "e": 61, "emph": false, "beat": "b01"}, {"text": "longer", "words": [5], "s": 61, "e": 75, "emph": false, "beat": "b01"}, {"text": "than it is", "words": [6, 7, 8], "s": 75, "e": 88, "emph": false, "beat": "b01"}, {"text": "wide.", "words": [9], "s": 88, "e": 111, "emph": true, "beat": "b01"}, {"text": "Chile", "words": [10], "s": 111, "e": 123, "emph": false, "beat": "b02"}, {"text": "runs", "words": [11], "s": 123, "e": 129, "emph": false, "beat": "b02"}, {"text": "4,270", "words": [12], "s": 129, "e": 182, "emph": true, "beat": "b02"}, {"text": "kilometers", "words": [13], "s": 182, "e": 199, "emph": false, "beat": "b02"},
:"push"},{"id":"b03","shot":"s03","role":null,"text":"A chip takes that sound wave and flips it upside down.","s":223,"speechEnd":318,"e":320,"words":[21,31],"transition":"push"},{"id":"b04","shot":"s03","role":null,"text":"Then the speaker plays the flipped wave straight into your ear.","s":320,"speechEnd":422,"e":426,"words":[32,42],"transition":null},{"id":"b05","shot":"s04","role":null,"text":"Peak meets valley, the two waves cancel, and you hear almost nothing.","s":426,"speechEnd":546,"e":551,"words":[43,54],"transition":"dissolve"},{"id":"b06","shot":"s05","role":null,"text":"But there's a catch.","s":551,"speechEnd":587,"e":589,"words":[55,58],"transition":"whip-left"},{"id":"b07","shot":"s05","role":null,"text":"It works best on steady, low sounds, like the hum of a plane engine.","s":589,"speechEnd":713,"e":718,"words":[59,72],"transition":null},{"id":"b08","shot":"s06","role":"pivot","text":"You see, a steady hum repeats, so the chip can keep matching it.","s":718,"speechEnd":831,"e":834,"words":[73,85],"transition":"push"},{"id":"b09","shot":"s06","role":null,"text":"A sudden voice changes too fast, and slips right through.","s":834,"speechEnd":938,"e":942,"words":[86,95],"transition":null},{"id":"b10","shot":"s07","role":null,"text":"That's why the padding matters. It blocks the high sounds the chip can't.","s":942,"speechEnd":1059,"e":1061,"words":[96,108],"transition":"dissolve"},{"id":"b11","shot":"s07","role":"payoff","text":"So the silence you paid for is really two noises fighting.","s":1061,"speechEnd":1167,"e":1167,"words":[109,119],"transition":null}],"shots":[{"id":"s01","beats":["b01"],"s":0,"e":97,"transitionIn":null},{"id":"s02","beats":["b02"],"s":97,"e":220,"transitionIn":"push"},{"id":"s03","beats":["b03","b04"],"s":220,"e":423,"transitionIn":"push"},{"id":"s04","beats":["b05"],"s":423,"e":548,"transitionIn":"dissolve"},{"id":"s05","beats":["b06","b07"],"s":548,"e":715,"transitionIn":"whip-left"},{"id":"s06","beats":["b08","b09"],"s":715
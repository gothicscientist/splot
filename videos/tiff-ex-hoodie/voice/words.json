 "beats": [
  {
   "id": "b01",
   "shot": "s01",
   "start": 0.06,
   "speechEnd": 2.1781,
   "end": 2.3981,
   "say": "My ex bought his own hoodie back... from me.",
   "tightenedSec": 0.0
  },
  {
   "id": "b02",
   "shot": "s02",
   "start": 2.3981,
   "speechEnd": 4.3201,
   "end": 4.4401,
   "say": "He left it at my place when we broke up.",
   "tightenedSec": 0.0
  },
  {
   "id": "b03",
   "shot": "s02",
   "start": 4.4401,
   "speechEnd": 6.7837,
   "end": 6.9437,
   "say": "For three months, it just lived on my chair.",
   "tightenedSec": 0.0
  },
  {
   "id": "b04",
   "shot": "s03",
   "start": 6.9437,
   "speechEnd": 10.6458,
   "end": 10.8058,
   "say": "My best friend said burn it. I said, it's a really nice hoodie.",
   "tightenedSec": 0.272
  },
  {
   "id": "b05",
   "shot": "s04",
   "start": 10.8058,
   "speechEnd": 13.9925,
   "end": 14.1525,
   "say": "So I listed it. Size large. Smells like regret.",
   "tightenedSec": 0.56
  },
  {
   "id": "b06",
   "shot": "s05",
   "start": 14.1525,
   "speechEnd": 17.817,
   "end": 17.977,
   "say": "A week later, it sells. And the buyer's name looks... familiar.",
   "tightenedSec": 0.268
  },
  {
   "id": "b07",
   "shot": "s06",
   "start": 17.977,
   "speechEnd": 20.0443,
   "end": 20.2643,
   "say": "Then a message: hey, is this mine?",
   "tightenedSec": 0.0
  },
  {
   "id": "b08",
   "shot": "s06",
   "start": 20.2643,
   "speechEnd": 22.0079,
   "end": 22.1679,
   "say": "I said: not anymore.",
   "tightenedSec": 0.0
  },
  {
   "id": "b09",
   "shot": "s07",
   "start": 22.1679,
   "speechEnd": 25.2489,
   "end": 25.2489,
   "say": "The rest of my chair? Listed everywhere at once with pile go.",
   "tightenedSec": 0.26
  }
 ],

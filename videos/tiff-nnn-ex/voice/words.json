 "beats": [
  {
   "id": "b01",
   "shot": "s01",
   "start": 0.06,
   "speechEnd": 2.3551,
   "end": 2.5751,
   "say": "My ex told me he was doing No Nut November.",
   "tightenedSec": 0.0
  },
  {
   "id": "b02",
   "shot": "s01",
   "start": 2.5751,
   "speechEnd": 6.1609,
   "end": 6.3209,
   "say": "Day three, I found out he was failing it... with my best friend.",
   "tightenedSec": 0.149
  },
  {
   "id": "b03",
   "shot": "s02",
   "start": 6.3209,
   "speechEnd": 9.4512,
   "end": 9.6712,
   "say": "I asked him straight up. He goes: why would I deceive you?",
   "tightenedSec": 0.579
  },
  {
   "id": "b04",
   "shot": "s03",
   "start": 9.6712,
   "speechEnd": 12.6189,
   "end": 12.7789,
   "say": "Then Mia posts a story. In his hoodie. In his bed.",
   "tightenedSec": 0.508
  },
  {
   "id": "b05",
   "shot": "s04",
   "start": 12.7789,
   "speechEnd": 17.5278,
   "end": 17.6878,
   "say": "I cried into my clothes pile for two days. The only thing in my room that still hugged me.",
   "tightenedSec": 0.271
  },
  {
   "id": "b06",
   "shot": "s05",
   "start": 17.6878,
   "speechEnd": 21.5166,
   "end": 21.6766,
   "say": "Then he texts me: you were never worth the effort. And the group chat laughed.",
   "tightenedSec": 0.413
  },
  {
   "id": "b07",
   "shot": "s06",
   "start": 21.6766,
   "speechEnd": 23.9391,
   "end": 24.0991,
   "say": "So I sold everything he ever gave me.",
   "tightenedSec": 0.0
  },
  {
   "id": "b08",
   "shot": "s07",
   "start": 24.0991,
   "speechEnd": 26.9731,
   "end": 27.0931,
   "say": "The hoodie sold in ten minutes. The buyer? Mia.",
   "tightenedSec": 0.519
  },
  {
   "id": "b09",
   "shot": "s07",
   "start": 27.0931,
   "speechEnd": 30.2384,
   "end": 30.3984,
   "say": "She paid full price to wear it for a guy who already left her too.",
   "tightenedSec": 0.0
  },
  {
   "id": "b10",
   "shot": "s08",
   "start": 30.3984,
   "speechEnd": 34.4925,
   "end": 34.4925,
   "say": "His stuff? Gone. My chair? Back. Listed everywhere with pile go.",
   "tightenedSec": 1.102
  }
 ],

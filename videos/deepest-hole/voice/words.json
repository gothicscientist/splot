{
 "version": 2,
 "sampleRate": 48000,
 "duration": 41.9306,
 "lead": 0.06,
 "provider": "take",
 "voice": "ElevenLabs Liam (viral short-form storyteller)",
 "tempo": 1.1636,
 "wpm": 180.0,
 "beats": [
  {
   "id": "b01",
   "shot": "s01",
   "start": 0.06,
   "speechEnd": 2.6488,
   "end": 2.8688,
   "say": "What if you dug straight down and never stopped?",
   "tightenedSec": 0.0
  },
  {
   "id": "b02",
   "shot": "s02",
   "start": 2.8688,
   "speechEnd": 5.6559,
   "end": 5.7159,
   "say": "In nineteen seventy, Soviet scientists tried it for real.",
   "tightenedSec": 0.0
  },
  {
   "id": "b03",
   "shot": "s02",
   "start": 5.7159,
   "speechEnd": 9.5384,
   "end": 9.6984,
   "say": "Their hole was just twenty-three centimeters wide, about the size of a dinner plate.",
   "tightenedSec": 0.0
  },
  {
   "id": "b04",
   "shot": "s03",
   "start": 9.6984,
   "speechEnd": 14.0343,
   "end": 14.1543,
   "say": "For nineteen years, the drill went down. One kilometer. Five. Ten.",
   "tightenedSec": 0.339
  },
  {
   "id": "b05",
   "shot": "s03",
   "start": 14.1543,
   "speechEnd": 19.3338,
   "end": 19.4938,
   "say": "At twelve thousand, two hundred and sixty-two meters, it became the deepest hole humans have ever made.",
   "tightenedSec": 0.0
  },
  {
   "id": "b06",
   "shot": "s04",
   "start": 19.4938,
   "speechEnd": 21.4113,
   "end": 21.4713,
   "say": "But down there, something was wrong.",
   "tightenedSec": 0.0
  },
  {
   "id": "b07",
   "shot": "s04",
   "start": 21.4713,
   "speechEnd": 25.5594,
   "end": 25.7194,
   "say": "The rock was one hundred and eighty degrees Celsius, far hotter than anyone expected.",
   "tightenedSec": 0.0
  },
  {
   "id": "b08",
   "shot": "s05",
   "start": 25.7194,
   "speechEnd": 30.3129,
   "end": 30.3729,
   "say": "You see, at that heat, rock stops acting like rock. It starts to behave like plastic.",
   "tightenedSec": 0.0
  },
  {
   "id": "b09",
   "shot": "s05",
   "start": 30.3729,
   "speechEnd": 32.65,
   "end": 32.81,
   "say": "The drill simply could not go any deeper.",
   "tightenedSec": 0.0
  },
  {
   "id": "b10",
   "shot": "s06",
   "start": 32.81,
   "speechEnd": 37.4796,
   "end": 37.5396,
   "say": "So how far did they get? The center of the Earth is six thousand, three hundred and seventy-one kilometers down.",
   "tightenedSec": 0.323
  },
  {
   "id": "b11",
   "shot": "s06",
   "start": 37.5396,
   "speechEnd": 41.2306,
   "end": 41.2306,
   "say": "After nineteen years of digging, they made it zero point two percent of the way.",
   "tightenedSec": 0.0
  }
 ],

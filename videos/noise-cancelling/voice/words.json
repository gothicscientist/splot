{
 "version": 2,
 "sampleRate": 48000,
 "duration": 39.5848,
 "lead": 0.06,
 "provider": "take",
 "voice": "ElevenLabs Liam (viral short-form storyteller)",
 "tempo": 1.0,
 "wpm": 186.3,
 "beats": [
  {
   "id": "b01",
   "shot": "s01",
   "start": 0.06,
   "speechEnd": 3.1092,
   "end": 3.3292,
   "say": "Your headphones don't block noise. They make more of it.",
   "tightenedSec": 0.0
  },
  {
   "id": "b02",
   "shot": "s02",
   "start": 3.3292,
   "speechEnd": 7.2762,
   "end": 7.4362,
   "say": "Tiny microphones on the outside listen to every sound around you.",
   "tightenedSec": 0.0
  },
  {
   "id": "b03",
   "shot": "s03",
   "start": 7.4362,
   "speechEnd": 10.599,
   "end": 10.659,
   "say": "A chip takes that sound wave and flips it upside down.",
   "tightenedSec": 0.0
  },
  {
   "id": "b04",
   "shot": "s03",
   "start": 10.659,
   "speechEnd": 14.0556,
   "end": 14.2156,
   "say": "Then the speaker plays the flipped wave straight into your ear.",
   "tightenedSec": 0.0
  },
  {
   "id": "b05",
   "shot": "s04",
   "start": 14.2156,
   "speechEnd": 18.1903,
   "end": 18.3503,
   "say": "Peak meets valley, the two waves cancel, and you hear almost nothing.",
   "tightenedSec": 0.0
  },
  {
   "id": "b06",
   "shot": "s05",
   "start": 18.3503,
   "speechEnd": 19.568,
   "end": 19.628,
   "say": "But there's a catch.",
   "tightenedSec": 0.0
  },
  {
   "id": "b07",
   "shot": "s05",
   "start": 19.628,
   "speechEnd": 23.766,
   "end": 23.926,
   "say": "It works best on steady, low sounds, like the hum of a plane engine.",
   "tightenedSec": 0.0
  },
  {
   "id": "b08",
   "shot": "s06",
   "start": 23.926,
   "speechEnd": 27.6878,
   "end": 27.8078,
   "say": "You see, a steady hum repeats, so the chip can keep matching it.",
   "tightenedSec": 0.0
  },
  {
   "id": "b09",
   "shot": "s06",
   "start": 27.8078,
   "speechEnd": 31.2565,
   "end": 31.4165,
   "say": "A sudden voice changes too fast, and slips right through.",
   "tightenedSec": 0.0
  },
  {
   "id": "b10",
   "shot": "s07",
   "start": 31.4165,
   "speechEnd": 35.2956,
   "end": 35.3556,
   "say": "That's why the padding matters. It blocks the high sounds the chip can't.",
   "tightenedSec": 0.0
  },
  {
   "id": "b11",
   "shot": "s07",
   "start": 35.3556,
   "speechEnd": 38.8848,
   "end": 38.8848,
   "say": "So the silence you paid for is really two noises fighting.",
   "tightenedSec": 0.0
  }
 ],

 "beats": [
  {
   "id": "b01",
   "shot": "s01",
   "start": 0.06,
   "speechEnd": 2.9765,
   "end": 3.1965,
   "say": "He quizzed me on underground rap, wearing a jacket I sold him.",
   "tightenedSec": 0.171
  },
  {
   "id": "b02",
   "shot": "s02",
   "start": 3.1965,
   "speechEnd": 5.4495,
   "end": 5.5695,
   "say": "Name three unreleased songs, or you're a larper.",
   "tightenedSec": 0.0
  },
  {
   "id": "b03",
   "shot": "s02",
   "start": 5.5695,
   "speechEnd": 8.4299,
   "end": 8.5899,
   "say": "So I name four, with the leak dates, before he blinks.",
   "tightenedSec": 0.121
  },
  {
   "id": "b04",
   "shot": "s03",
   "start": 8.5899,
   "speechEnd": 10.501,
   "end": 10.621,
   "say": "Okay, but that fit is probably reps.",
   "tightenedSec": 0.0
  },
  {
   "id": "b05",
   "shot": "s03",
   "start": 10.621,
   "speechEnd": 13.1855,
   "end": 13.3055,
   "say": "It's retail. I keep receipts like a tax office.",
   "tightenedSec": 0.208
  },
  {
   "id": "b06",
   "shot": "s03",
   "start": 13.3055,
   "speechEnd": 15.4983,
   "end": 15.6583,
   "say": "This jacket is real archive. You wouldn't know.",
   "tightenedSec": 0.772
  },
  {
   "id": "b07",
   "shot": "s04",
   "start": 15.6583,
   "speechEnd": 17.8788,
   "end": 18.0388,
   "say": "Except I know that jacket. It lived on my chair.",
   "tightenedSec": 0.246
  },
  {
   "id": "b08",
   "shot": "s05",
   "start": 18.0388,
   "speechEnd": 21.6777,
   "end": 21.7977,
   "say": "I listed it last month: mall brand, worn twice, forty dollars.",
   "tightenedSec": 0.494
  },
  {
   "id": "b09",
   "shot": "s05",
   "start": 21.7977,
   "speechEnd": 24.7535,
   "end": 24.9135,
   "say": "He offered four dollars first, then paid the full forty dollars.",
   "tightenedSec": 0.0
  },
  {
   "id": "b10",
   "shot": "s06",
   "start": 24.9135,
   "speechEnd": 27.4638,
   "end": 27.5838,
   "say": "I tell him: that's not archive. That's my chair.",
   "tightenedSec": 0.496
  },
  {
   "id": "b11",
   "shot": "s06",
   "start": 27.5838,
   "speechEnd": 29.712,
   "end": 29.932,
   "say": "Cool. Would you do thirty dollars for the boots?",
   "tightenedSec": 0.707
  },
  {
   "id": "b12",
   "shot": "s07",
   "start": 29.932,
   "speechEnd": 32.2831,
   "end": 32.3431,
   "say": "Back home, I snap the chair. Listed.",
   "tightenedSec": 0.164
  },
  {
   "id": "b13",
   "shot": "s07",
   "start": 32.3431,
   "speechEnd": 34.843,
   "end": 35.003,
   "say": "pile go! puts the whole chair live on five apps.",
   "tightenedSec": 0.149
  },
  {
   "id": "b14",
   "shot": "s08",
   "start": 35.003,
   "speechEnd": 38.3811,
   "end": 39.7811,
   "say": "So: thirty dollars for the boots. Accept, counter, or block?",
   "tightenedSec": 0.576
  }
 ],

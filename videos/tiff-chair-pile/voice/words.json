 "beats": [
  {
   "id": "b01",
   "shot": "s01",
   "start": 0.06,
   "speechEnd": 2.1228,
   "end": 2.3428,
   "say": "My chair hasn't been a chair since March.",
   "tightenedSec": 0.0
  },
  {
   "id": "b02",
   "shot": "s02",
   "start": 2.3428,
   "speechEnd": 4.6952,
   "end": 4.8152,
   "say": "It's a pile of clothes I swear I'm going to sell.",
   "tightenedSec": 0.0
  },
  {
   "id": "b03",
   "shot": "s02",
   "start": 4.8152,
   "speechEnd": 7.6004,
   "end": 7.7604,
   "say": "But selling one jacket is never just one jacket.",
   "tightenedSec": 0.0
  },
  {
   "id": "b04",
   "shot": "s03",
   "start": 7.7604,
   "speechEnd": 11.5004,
   "end": 11.6204,
   "say": "Every app wants its own photos, its own form, its own everything.",
   "tightenedSec": 0.0
  },
  {
   "id": "b05",
   "shot": "s03",
   "start": 11.6204,
   "speechEnd": 14.2455,
   "end": 14.4055,
   "say": "So I list it on one app, and it just sits there.",
   "tightenedSec": 0.0
  },
  {
   "id": "b06",
   "shot": "s04",
   "start": 14.4055,
   "speechEnd": 18.9501,
   "end": 19.0701,
   "say": "Resellers fix that with crosslisting: the same item on every app at once.",
   "tightenedSec": 0.211
  },
  {
   "id": "b07",
   "shot": "s04",
   "start": 19.0701,
   "speechEnd": 20.6554,
   "end": 20.8154,
   "say": "More apps, more people see it.",
   "tightenedSec": 0.0
  },
  {
   "id": "b08",
   "shot": "s05",
   "start": 20.8154,
   "speechEnd": 23.37,
   "end": 23.49,
   "say": "But then it sells on Depop... and again on Vin-ted.",
   "tightenedSec": 0.0
  },
  {
   "id": "b09",
   "shot": "s05",
   "start": 23.49,
   "speechEnd": 25.3916,
   "end": 25.5516,
   "say": "Now I'm refunding a stranger at midnight.",
   "tightenedSec": 0.0
  },
  {
   "id": "b10",
   "shot": "s06",
   "start": 25.5516,
   "speechEnd": 28.8061,
   "end": 28.9261,
   "say": "So now I snap the pile, and pile go lists it everywhere.",
   "tightenedSec": 0.0
  },
  {
   "id": "b11",
   "shot": "s06",
   "start": 28.9261,
   "speechEnd": 31.8951,
   "end": 32.0551,
   "say": "When one sells, it comes down everywhere else.",
   "tightenedSec": 0.0
  },
  {
   "id": "b12",
   "shot": "s07",
   "start": 32.0551,
   "speechEnd": 35.5305,
   "end": 35.5305,
   "say": "It's free, it's open source, and look: I have a chair again.",
   "tightenedSec": 0.0
  }
 ],

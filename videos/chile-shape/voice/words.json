 "tempo": 1.0392,
 "wpm": 184.7,
 "beats": [
  {
   "id": "b01",
   "shot": "s01",
   "start": 0.06,
   "speechEnd": 3.4264,
   "end": 3.6464,
   "say": "This country is twenty-four times longer than it is wide.",
   "tightenedSec": 0.0
  },
  {
   "id": "b02",
   "shot": "s02",
   "start": 3.6464,
   "speechEnd": 7.5434,
   "end": 7.6634,
   "say": "Chile runs four thousand, two hundred and seventy kilometers from top to bottom.",
   "tightenedSec": 0.0
  },
  {
   "id": "b03",
   "shot": "s02",
   "start": 7.6634,
   "speechEnd": 11.766,
   "end": 11.926,
   "say": "It starts in one of the driest deserts on Earth, and ends among glaciers.",
   "tightenedSec": 0.0
  },
  {
   "id": "b04",
   "shot": "s03",
   "start": 11.926,
   "speechEnd": 16.1571,
   "end": 16.3171,
   "say": "Slide it over Europe, and it reaches from the top of Norway past the bottom of Spain.",
   "tightenedSec": 0.0
  },
  {
   "id": "b05",
   "shot": "s04",
   "start": 16.3171,
   "speechEnd": 20.4125,
   "end": 20.5325,
   "say": "But side to side, it averages just one hundred and seventy-seven kilometers.",
   "tightenedSec": 0.0
  },
  {
   "id": "b06",
   "shot": "s04",
   "start": 20.5325,
   "speechEnd": 21.9728,
   "end": 22.1328,
   "say": "So why is it so thin?",
   "tightenedSec": 0.0
  },
  {
   "id": "b07",
   "shot": "s05",
   "start": 22.1328,
   "speechEnd": 23.9273,
   "end": 24.0473,
   "say": "On one side, the Pacific Ocean.",
   "tightenedSec": 0.0
  },
  {
   "id": "b08",
   "shot": "s05",
   "start": 24.0473,
   "speechEnd": 28.0805,
   "end": 28.2405,
   "say": "On the other, the Andes, the longest mountain range on any continent.",
   "tightenedSec": 0.0
  },
  {
   "id": "b09",
   "shot": "s06",
   "start": 28.2405,
   "speechEnd": 32.0225,
   "end": 32.0825,
   "say": "You see, in eighteen eighty-one, Chile and Argentina signed a border treaty.",
   "tightenedSec": 0.0
  },
  {
   "id": "b10",
   "shot": "s06",
   "start": 32.0825,
   "speechEnd": 34.7513,
   "end": 34.9113,
   "say": "The line would follow the highest peaks of the Andes.",
   "tightenedSec": 0.0
  },
  {
   "id": "b11",
   "shot": "s07",
   "start": 34.9113,
   "speechEnd": 38.218,
   "end": 38.278,
   "say": "So Chile kept the narrow strip between the mountains and the sea.",
   "tightenedSec": 0.0
  },
  {
   "id": "b12",
   "shot": "s07",
   "start": 38.278,
   "speechEnd": 41.2047,
   "end": 41.2047,
   "say": "It's not a strange shape. It's the edge of a continent.",
   "tightenedSec": 0.0
  }
 ],

   "start": 0.0,
   "speechEnd": 4.4,
   "end": 4.56,
   "say": "my ex soft-launched his new girlfriend... in my dress.",
   "tightenedSec": 0.0
  },
  {
   "id": "b02",
   "shot": "s02",
   "start": 4.56,
   "speechEnd": 7.76,
   "end": 8.0,
   "say": "the green one. i sold it last month to clear my chair.",
   "tightenedSec": 0.0
  },
  {
   "id": "b03",
   "shot": "s02",
   "start": 8.0,
   "speechEnd": 11.96,
   "end": 12.16,
   "say": "same slit. same tiny burn mark from my birthday candles.",
   "tightenedSec": 0.0
  },
  {
   "id": "b04",
   "shot": "s03",
   "start": 12.16,
   "speechEnd": 15.76,
   "end": 15.84,
   "say": "he captioned it: finally, someone with taste.",
   "tightenedSec": 0.0
  },
  {
   "id": "b05",
   "shot": "s03",
   "start": 15.84,
   "speechEnd": 18.24,
   "end": 18.56,
   "say": "the comments were already picking sides.",
   "tightenedSec": 0.0
  },
  {
   "id": "b06",
   "shot": "s04",
   "start": 18.56,
   "speechEnd": 24.08,
   "end": 24.2,
   "say": "so i checked who bought the dress. sasha. two days before their first date.",
   "tightenedSec": 0.0
  },
  {
   "id": "b07",
   "shot": "s04",
   "start": 24.2,
   "speechEnd": 27.84,
   "end": 27.92,
   "say": "then sasha messaged me: wait, are you his tiff?",
   "tightenedSec": 0.0
  },
  {
   "id": "b08",
   "shot": "s05",
   "start": 27.92,
   "speechEnd": 31.4,
   "end": 31.816,
   "say": "i sent her one screenshot. she sent back twelve.",
   "tightenedSec": 0.0
  },
  {
   "id": "b09",
   "shot": "s05",
   "start": 31.816,
   "speechEnd": 34.44,
   "end": 34.72,
   "say": "turns out he told us both the same lines.",
   "tightenedSec": 0.0
  },
  {
   "id": "b10",
   "shot": "s06",
   "start": 34.72,
   "speechEnd": 38.96,
   "end": 39.04,
   "say": "she kept the dress. i listed everything he ever touched on pile go.",
   "tightenedSec": 0.0
  },
  {
   "id": "b11",
   "shot": "s06",
   "start": 39.04,
   "speechEnd": 41.44,
   "end": 43.36,
   "say": "we have a group chat now. he's not in it.",
   "tightenedSec": 0.0
  }
 ],

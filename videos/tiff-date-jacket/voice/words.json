 "beats": [
  {
   "id": "b01",
   "shot": "s01",
   "start": 0.06,
   "speechEnd": 1.7713,
   "end": 1.9913,
   "say": "My date showed up wearing my jacket.",
   "tightenedSec": 0.0
  },
  {
   "id": "b02",
   "shot": "s02",
   "start": 1.9913,
   "speechEnd": 5.9891,
   "end": 6.1491,
   "say": "Not one like mine. Mine. The olive one with the coffee stain on the sleeve.",
   "tightenedSec": 0.453
  },
  {
   "id": "b03",
   "shot": "s03",
   "start": 6.1491,
   "speechEnd": 8.8159,
   "end": 8.9759,
   "say": "I sold it online in March, to clear out my chair.",
   "tightenedSec": 0.0
  },
  {
   "id": "b04",
   "shot": "s04",
   "start": 8.9759,
   "speechEnd": 11.5845,
   "end": 11.7045,
   "say": "And now he's telling me it's his favorite thing he owns.",
   "tightenedSec": 0.0
  },
  {
   "id": "b05",
   "shot": "s04",
   "start": 11.7045,
   "speechEnd": 14.0303,
   "end": 14.1903,
   "say": "He found it secondhand, and it just fit.",
   "tightenedSec": 0.0
  },
  {
   "id": "b06",
   "shot": "s05",
   "start": 14.1903,
   "speechEnd": 15.7806,
   "end": 16.0006,
   "say": "Do I tell him? On a first date?",
   "tightenedSec": 0.23
  },
  {
   "id": "b07",
   "shot": "s06",
   "start": 16.0006,
   "speechEnd": 18.5603,
   "end": 18.7203,
   "say": "Then he spills his coffee. On the same sleeve.",
   "tightenedSec": 0.233
  },
  {
   "id": "b08",
   "shot": "s07",
   "start": 18.7203,
   "speechEnd": 21.576,
   "end": 21.696,
   "say": "So I told him. He laughed so hard he cried.",
   "tightenedSec": 0.248
  },
  {
   "id": "b09",
   "shot": "s07",
   "start": 21.696,
   "speechEnd": 24.1061,
   "end": 24.2661,
   "say": "Second date's Friday. He's wearing it again.",
   "tightenedSec": 0.271
  },
  {
   "id": "b10",
   "shot": "s08",
   "start": 24.2661,
   "speechEnd": 28.013,
   "end": 28.013,
   "say": "Your pile could be someone's favorite thing. I list mine with pile go.",
   "tightenedSec": 0.276
  }
 ],

   "start": 0.0,
   "speechEnd": 4.04,
   "end": 4.4,
   "say": "my ex-best friend showed up to friendsgiving uninvited.",
   "tightenedSec": 0.0
  },
  {
   "id": "b02",
   "shot": "s02",
   "start": 4.4,
   "speechEnd": 7.56,
   "end": 7.92,
   "say": "mia. the one who hooked up with my ex.",
   "tightenedSec": 0.0
  },
  {
   "id": "b03",
   "shot": "s02",
   "start": 7.92,
   "speechEnd": 11.52,
   "end": 11.64,
   "say": "everyone went quiet. even the turkey looked away.",
   "tightenedSec": 0.0
  },
  {
   "id": "b04",
   "shot": "s03",
   "start": 11.64,
   "speechEnd": 15.76,
   "end": 15.8,
   "say": "she said: i'm not here to apologize. i'm here about the jacket.",
   "tightenedSec": 0.0
  },
  {
   "id": "b05",
   "shot": "s03",
   "start": 15.8,
   "speechEnd": 18.24,
   "end": 18.36,
   "say": "the leather one jake gave me for christmas.",
   "tightenedSec": 0.0
  },
  {
   "id": "b06",
   "shot": "s04",
   "start": 18.36,
   "speechEnd": 20.88,
   "end": 21.0,
   "say": "she pulled out the exact same jacket.",
   "tightenedSec": 0.0
  },
  {
   "id": "b07",
   "shot": "s04",
   "start": 21.0,
   "speechEnd": 24.36,
   "end": 24.64,
   "say": "same size. same gift note. same christmas.",
   "tightenedSec": 0.0
  },
  {
   "id": "b08",
   "shot": "s05",
   "start": 24.64,
   "speechEnd": 27.84,
   "end": 27.96,
   "say": "he bought one present and gave it to us both.",
   "tightenedSec": 0.0
  },
  {
   "id": "b09",
   "shot": "s05",
   "start": 27.96,
   "speechEnd": 30.4,
   "end": 30.48,
   "say": "we stared at each other for a full minute.",
   "tightenedSec": 0.0
  },
  {
   "id": "b10",
   "shot": "s06",
   "start": 30.48,
   "speechEnd": 33.36,
   "end": 33.52,
   "say": "so we listed both jackets on pile go that night.",
   "tightenedSec": 0.0
  },
  {
   "id": "b11",
   "shot": "s06",
   "start": 33.52,
   "speechEnd": 37.04,
   "end": 37.52,
   "say": "mine sold for two hundred dollars. hers was a knockoff.",
   "tightenedSec": 0.0
  },
  {
   "id": "b12",
   "shot": "s07",
   "start": 37.52,
   "speechEnd": 41.12,
   "end": 43.04,
   "say": "funny. now she's finally mad at the right person.",
   "tightenedSec": 0.0
  }

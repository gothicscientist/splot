 "beats": [
  {
   "id": "b01",
   "shot": "s01",
   "start": 0.06,
   "speechEnd": 2.3494,
   "end": 2.5694,
   "say": "I sold the same jacket... to two people.",
   "tightenedSec": 0.0
  },
  {
   "id": "b02",
   "shot": "s02",
   "start": 2.5694,
   "speechEnd": 5.9538,
   "end": 6.0738,
   "say": "It was on Depop and Vin-ted, because more apps means more buyers.",
   "tightenedSec": 0.0
  },
  {
   "id": "b03",
   "shot": "s02",
   "start": 6.0738,
   "speechEnd": 7.6262,
   "end": 7.7862,
   "say": "Both sold in the same hour.",
   "tightenedSec": 0.0
  },
  {
   "id": "b04",
   "shot": "s03",
   "start": 7.7862,
   "speechEnd": 11.5633,
   "end": 11.7233,
   "say": "One buyer got the jacket. The other got a refund and a one-star review.",
   "tightenedSec": 0.296
  },
  {
   "id": "b05",
   "shot": "s04",
   "start": 11.7233,
   "speechEnd": 14.2811,
   "end": 14.4011,
   "say": "Crosslisting isn't the problem. Delisting is.",
   "tightenedSec": 0.23
  },
  {
   "id": "b06",
   "shot": "s04",
   "start": 14.4011,
   "speechEnd": 17.7256,
   "end": 17.8856,
   "say": "Every sale means racing through five other apps to take it down.",
   "tightenedSec": 0.0
  },
  {
   "id": "b07",
   "shot": "s05",
   "start": 17.8856,
   "speechEnd": 19.5961,
   "end": 19.7561,
   "say": "And my prices? Pure guessing.",
   "tightenedSec": 0.281
  },
  {
   "id": "b08",
   "shot": "s06",
   "start": 19.7561,
   "speechEnd": 22.8411,
   "end": 22.9611,
   "say": "Now I snap it once, and pile go lists it on six apps.",
   "tightenedSec": 0.0
  },
  {
   "id": "b09",
   "shot": "s06",
   "start": 22.9611,
   "speechEnd": 25.5834,
   "end": 25.7034,
   "say": "Prices come from what things actually sold for on eBay.",
   "tightenedSec": 0.0
  },
  {
   "id": "b10",
   "shot": "s06",
   "start": 25.7034,
   "speechEnd": 28.424,
   "end": 28.584,
   "say": "When it sells, it comes down everywhere else.",
   "tightenedSec": 0.0
  },
  {
   "id": "b11",
   "shot": "s07",
   "start": 28.584,
   "speechEnd": 31.3844,
   "end": 31.3844,
   "say": "Same jacket. One buyer. Zero apologies.",
   "tightenedSec": 0.506
  }
 ],

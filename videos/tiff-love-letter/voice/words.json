 "beats": [
  {
   "id": "b01",
   "shot": "s01",
   "start": 0.06,
   "speechEnd": 4.1195,
   "end": 4.3395,
   "say": "I almost sold a love letter for twelve dollars. It was thirty-seven years late.",
   "tightenedSec": 0.249
  },
  {
   "id": "b02",
   "shot": "s02",
   "start": 4.3395,
   "speechEnd": 7.6539,
   "end": 7.7739,
   "say": "I was clearing my clothes chair, snapping everything to list.",
   "tightenedSec": 0.0
  },
  {
   "id": "b03",
   "shot": "s02",
   "start": 7.7739,
   "speechEnd": 10.993,
   "end": 11.153,
   "say": "When I snapped a thrifted jacket, something crinkled in the pocket.",
   "tightenedSec": 0.0
  },
  {
   "id": "b04",
   "shot": "s03",
   "start": 11.153,
   "speechEnd": 14.2123,
   "end": 14.3323,
   "say": "A letter. Dated nineteen eighty-seven. Never sent.",
   "tightenedSec": 0.494
  },
  {
   "id": "b05",
   "shot": "s03",
   "start": 14.3323,
   "speechEnd": 16.8956,
   "end": 17.0156,
   "say": "It said: June, I should have asked you to stay.",
   "tightenedSec": 0.0
  },
  {
   "id": "b06",
   "shot": "s03",
   "start": 17.0156,
   "speechEnd": 18.1918,
   "end": 18.3518,
   "say": "Signed: Robert.",
   "tightenedSec": 0.0
  },
  {
   "id": "b07",
   "shot": "s04",
   "start": 18.3518,
   "speechEnd": 20.1202,
   "end": 20.2802,
   "say": "June... is my grandma's name.",
   "tightenedSec": 0.0
  },
  {
   "id": "b08",
   "shot": "s05",
   "start": 20.2802,
   "speechEnd": 24.6728,
   "end": 24.7928,
   "say": "I showed her. She went quiet. Then she said: he wore that jacket every day.",
   "tightenedSec": 0.788
  },
  {
   "id": "b09",
   "shot": "s05",
   "start": 24.7928,
   "speechEnd": 27.5833,
   "end": 27.7433,
   "say": "She waited thirty-seven years to read that sentence.",
   "tightenedSec": 0.0
  },
  {
   "id": "b10",
   "shot": "s06",
   "start": 27.7433,
   "speechEnd": 31.13,
   "end": 31.13,
   "say": "Now both me and my grandma are up fifty dollars using pile go.",
   "tightenedSec": 0.0
  }
 ],

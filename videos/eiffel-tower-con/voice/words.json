 "tempo": 1.041,
 "wpm": 188.3,
 "beats": [
  {
   "id": "b01",
   "shot": "s01",
   "start": 0.06,
   "speechEnd": 2.6769,
   "end": 2.8969,
   "say": "This man sold the Eiffel Tower... for scrap metal.",
   "tightenedSec": 0.143
  },
  {
   "id": "b02",
   "shot": "s02",
   "start": 2.8969,
   "speechEnd": 8.4657,
   "end": 8.5857,
   "say": "Paris, nineteen twenty-five. Victor Lustig is reading the paper when he spots a tiny story.",
   "tightenedSec": 0.26
  },
  {
   "id": "b03",
   "shot": "s02",
   "start": 8.5857,
   "speechEnd": 11.5634,
   "end": 11.7234,
   "say": "The tower is rusting, and repainting it costs a fortune.",
   "tightenedSec": 0.181
  },
  {
   "id": "b04",
   "shot": "s03",
   "start": 11.7234,
   "speechEnd": 16.3688,
   "end": 16.5288,
   "say": "So he forges government letterhead and becomes a deputy director at the Ministry of Posts.",
   "tightenedSec": 0.0
  },
  {
   "id": "b05",
   "shot": "s04",
   "start": 16.5288,
   "speechEnd": 20.4658,
   "end": 20.5858,
   "say": "He books a suite at the Hôtel de Kree-yon and invites five scrap dealers.",
   "tightenedSec": 0.125
  },
  {
   "id": "b06",
   "shot": "s04",
   "start": 20.5858,
   "speechEnd": 25.2016,
   "end": 25.3616,
   "say": "His pitch: the city is secretly tearing the tower down. Seven thousand tons of iron.",
   "tightenedSec": 0.461
  },
  {
   "id": "b07",
   "shot": "s05",
   "start": 25.3616,
   "speechEnd": 28.977,
   "end": 29.097,
   "say": "One dealer, André Pwa-sohn, wants it badly. But something feels off.",
   "tightenedSec": 0.292
  },
  {
   "id": "b08",
   "shot": "s05",
   "start": 29.097,
   "speechEnd": 32.7322,
   "end": 32.8922,
   "say": "So Lustig makes a confession. He's a corrupt official, and he needs a bribe.",
   "tightenedSec": 0.237
  },
  {
   "id": "b09",
   "shot": "s06",
   "start": 32.8922,
   "speechEnd": 37.6201,
   "end": 37.7401,
   "say": "You see, to Pwa-sohn, the bribe was the proof. Only a real official would ask for one.",
   "tightenedSec": 0.734
  },
  {
   "id": "b10",
   "shot": "s06",
   "start": 37.7401,
   "speechEnd": 42.9507,
   "end": 43.1107,
   "say": "So Pwa-sohn pays twenty thousand dollars, plus fifty thousand dollars more to win.",
   "tightenedSec": 0.245
  },
  {
   "id": "b11",
   "shot": "s07",
   "start": 43.1107,
   "speechEnd": 46.0014,
   "end": 46.1614,
   "say": "Within the hour, Lustig is on a train to Vienna with the cash.",
   "tightenedSec": 0.268
  },
  {
   "id": "b12",
   "shot": "s08",
   "start": 46.1614,
   "speechEnd": 50.6609,
   "end": 50.8209,
   "say": "He waits for the headlines. Nothing. Pwa-sohn is too embarrassed to report it.",
   "tightenedSec": 0.432
  },
  {
   "id": "b13",
   "shot": "s09",
   "start": 50.8209,
   "speechEnd": 54.0907,
   "end": 54.1507,
   "say": "So Lustig comes back to Paris and tries to sell the tower again.",
   "tightenedSec": 0.0
  },
  {
   "id": "b14",
   "shot": "s09",
   "start": 54.1507,
   "speechEnd": 57.9683,
   "end": 58.1283,
   "say": "This time, the buyer calls the police, and Lustig escapes to America.",
   "tightenedSec": 0.189
  },
  {
   "id": "b15",
   "shot": "s10",
   "start": 58.1283,
   "speechEnd": 63.0143,
   "end": 63.0143,
   "say": "But historians have never found a single police report. The only proof might be a con man's word.",
   "tightenedSec": 0.272
  }
 ],

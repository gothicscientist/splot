{
 "version": 2,
 "sampleRate": 48000,
 "duration": 65.1151,
 "lead": 0.06,
 "provider": "take",
 "voice": "ElevenLabs Liam (viral short-form storyteller)",
 "tempo": 1.0598,
 "wpm": 184.7,
 "beats": [
  {
   "id": "b01",
   "shot": "s01",
   "start": 0.06,
   "speechEnd": 3.6454,
   "end": 3.8654,
   "say": "This man sold the Eiffel Tower... for scrap metal.",
   "tightenedSec": 0.0
  },
  {
   "id": "b02",
   "shot": "s02",
   "start": 3.8654,
   "speechEnd": 9.1841,
   "end": 9.3041,
   "say": "Paris, nineteen twenty-five. Victor Lustig is reading the paper when he spots a tiny story.",
   "tightenedSec": 0.376
  },
  {
   "id": "b03",
   "shot": "s02",
   "start": 9.3041,
   "speechEnd": 12.3315,
   "end": 12.4915,
   "say": "The tower is rusting, and repainting it costs a fortune.",
   "tightenedSec": 0.0
  },
  {
   "id": "b04",
   "shot": "s03",
   "start": 12.4915,
   "speechEnd": 17.1327,
   "end": 17.2927,
   "say": "So he forges government letterhead and becomes a deputy director at the Ministry of Posts.",
   "tightenedSec": 0.0
  },
  {
   "id": "b05",
   "shot": "s04",
   "start": 17.2927,
   "speechEnd": 21.0421,
   "end": 21.1621,
   "say": "He books a suite at the Hôtel de Crillon and invites five scrap dealers.",
   "tightenedSec": 0.0
  },
  {
   "id": "b06",
   "shot": "s04",
   "start": 21.1621,
   "speechEnd": 26.136,
   "end": 26.296,
   "say": "His pitch: the city is secretly tearing the tower down. Seven thousand tons of iron.",
   "tightenedSec": 0.4
  },
  {
   "id": "b07",
   "shot": "s05",
   "start": 26.296,
   "speechEnd": 30.4517,
   "end": 30.5717,
   "say": "One dealer, André Poisson, wants it badly. But something feels off.",
   "tightenedSec": 0.247
  },
  {
   "id": "b08",
   "shot": "s05",
   "start": 30.5717,
   "speechEnd": 34.8672,
   "end": 35.0272,
   "say": "So Lustig makes a confession. He's a corrupt official, and he needs a bribe.",
   "tightenedSec": 0.215
  },
  {
   "id": "b09",
   "shot": "s06",
   "start": 35.0272,
   "speechEnd": 39.5564,
   "end": 39.6764,
   "say": "You see, to Poisson, the bribe was the proof. Only a real official would ask for one.",
   "tightenedSec": 0.179
  },
  {
   "id": "b10",
   "shot": "s06",
   "start": 39.6764,
   "speechEnd": 44.3491,
   "end": 44.5091,
   "say": "So Poisson pays twenty thousand dollars, plus fifty thousand dollars more to win.",
   "tightenedSec": 0.0
  },
  {
   "id": "b11",
   "shot": "s07",
   "start": 44.5091,
   "speechEnd": 47.6595,
   "end": 47.8195,
   "say": "Within the hour, Lustig is on a train to Vienna with the cash.",
   "tightenedSec": 0.0
  },
  {
   "id": "b12",
   "shot": "s08",
   "start": 47.8195,
   "speechEnd": 51.6754,
   "end": 51.8354,
   "say": "He waits for the headlines. Nothing. Poisson is too embarrassed to report it.",
   "tightenedSec": 0.694
  },
  {
   "id": "b13",
   "shot": "s09",
   "start": 51.8354,
   "speechEnd": 55.319,
   "end": 55.379,
   "say": "So Lustig comes back to Paris and tries to sell the tower again.",
   "tightenedSec": 0.0
  },
  {
   "id": "b14",
   "shot": "s09",
   "start": 55.379,
   "speechEnd": 59.0021,
   "end": 59.1621,
   "say": "This time, the buyer calls the police, and Lustig escapes to America.",
   "tightenedSec": 0.0
  },
  {
   "id": "b15",
   "shot": "s10",
   "start": 59.1621,
   "speechEnd": 64.4151,
   "end": 64.4151,
   "say": "But historians have never found a single police report. The only proof might be a con man's word.",
   "tightenedSec": 0.27
  }
 ],
